{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"],
    "strict": true
  },
  "imports": {
    "@webdetta/context": "jsr:@webdetta/context@^0.1.0",
    "@deno/graph": "jsr:@deno/graph@^0.89.2",
    "typescript": "npm:typescript@5.8.3",
    "graphviz": "npm:node-graphviz@^0.1.1",
    "@std/collections": "jsr:@std/collections@^1.2.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "zx": "npm:zx/globals"
  },
  "workspace": ["./context"],
  "tasks": {
    "lint:circular": "deno run --allow-env --allow-read --allow-write --allow-net=deno.land,jsr.io _tools/check-circular-package-dependencies.js",
    "lint:entrypoints": "deno run -A _tools/check-entrypoints.js",
    "lint:import-map": "deno run -A _tools/check-import-map.js",
    "lint:unstable-deps": "deno run -A _tools/check-unstable-deps.js",
    "lint": "deno lint && deno task lint:circular && deno task lint:entrypoints && deno task lint:import-map && deno task lint:unstable-deps",
    "check": "deno check context/",
    "coverage": "deno run -A _tools/coverage.js",
    "typos": "typos -c ./.github/typos.toml",
    "ok": "deno task lint && deno fmt --check && deno task check"
  },
  "exclude": ["coverage", "**/*.test.js"],
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "exclude": ["no-slow-types"]
    },
    "exclude": ["_tools/*.js"]
  }
}
